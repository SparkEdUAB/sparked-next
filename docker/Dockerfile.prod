FROM node:22.14.0 AS base
WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Bun is the package manager; Node stays the runtime
COPY --from=oven/bun:1.4.5 /usr/local/bin/bun /usr/local/bin/bun

COPY package.json bun.lock ./

# Install dependencies and rebuild native modules
RUN bun ci

# Copy source files
COPY . .

# Build the application with production environment
RUN NODE_ENV=production bun run build

FROM node:22.14.0 AS release
WORKDIR /app

# Copy necessary files
COPY --from=base /app/package.json ./package.json
COPY --from=base /app/bun.lock ./bun.lock
COPY --from=base /app/.next ./.next
COPY --from=base /app/public ./public
COPY --from=base /app/node_modules ./node_modules

ENV NODE_ENV=production
# Fewer glibc malloc arenas: stops sharp/libvips buffers fragmenting RSS
ENV MALLOC_ARENA_MAX=2

EXPOSE 3000

CMD ["node", "node_modules/next/dist/bin/next", "start"]
