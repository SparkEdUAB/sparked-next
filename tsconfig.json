{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/components/*": ["./src/components/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@hocs/*": ["./src/hocs/*"],
      "@stores/*": ["./src/stores/*"],
      "@state/*": ["./src/state/*"],
      "@app/api*": ["./src/app/api*"],
      "@app/api/lib*": ["./src/app/api/lib*"],
      "app/*": ["./src/app/*"],
      "emails/*": ["./src/emails/*"],
      "fetchers/*": ["./src/fetchers/*"],
      "providers/*": ["./src/providers/*"],
      "routes": ["./src/routes"],
      "stores/*": ["./src/stores/*"],
      "types": ["./src/types"],
      "types/*": ["./src/types/*"],
      "utils/*": ["./src/utils/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
